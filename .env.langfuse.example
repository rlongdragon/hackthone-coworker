# Secrets for docker-compose.langfuse.yml — copy to .env.langfuse (gitignored):
#   cp .env.langfuse.example .env.langfuse && edit
#   docker compose --env-file .env.langfuse -f docker-compose.langfuse.yml up -d
#
# Generate:  openssl rand -base64 32   (SALT, NEXTAUTH_SECRET)
#            openssl rand -hex 32      (ENCRYPTION_KEY — must be 64 hex chars)
#            openssl rand -hex 8       (admin password)
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
# Project API keys created at first boot. Copy the same two values into
# web/.env.local as LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-<uuid>
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-<uuid>
# Langfuse UI login: admin@example.com / this password
LANGFUSE_INIT_USER_PASSWORD=
