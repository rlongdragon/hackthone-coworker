#!/usr/bin/env python3
"""doc2pdf <input> <output.pdf> — convert md/docx/txt/html to PDF with CJK fonts.

pandoc turns the input into HTML, weasyprint renders it to PDF using the
system Noto CJK fonts (reportlab's default fonts have no CJK glyphs, which is
why plain reportlab produces tofu/blank Chinese). Use this for any PDF that may
contain Chinese/Japanese/Korean text.
"""
import os
import subprocess
import sys

import weasyprint

if len(sys.argv) != 3:
    sys.exit("usage: doc2pdf <input> <output.pdf>")
inp, out = sys.argv[1], sys.argv[2]
ext = os.path.splitext(inp)[1].lower()

if ext in (".html", ".htm"):
    with open(inp, encoding="utf-8") as f:
        body = f.read()
else:
    body = subprocess.run(
        ["pandoc", inp, "-t", "html"],
        capture_output=True, text=True, check=True,
    ).stdout

css = (
    '<meta charset="utf-8"><style>'
    '*{font-family:"Noto Sans CJK TC","Noto Sans CJK SC","Noto Sans CJK JP",sans-serif}'
    "body{margin:2em;line-height:1.6}"
    "h1,h2,h3{margin:.6em 0 .3em}"
    "table{border-collapse:collapse}td,th{border:1px solid #999;padding:4px 8px}"
    "</style>"
)
weasyprint.HTML(string=css + body).write_pdf(out)
print("wrote", out)
