{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker:telegram": "tsx --dns-result-order=ipv4first --env-file=.env.local worker/telegram.ts",
    "test": "for t in delegation red-team a2a tg-digest mail dispatch mcp mcp-http mcp-repo; do echo \"=== $t ===\"; tsx --env-file=.env.local worker/$t.test.mts || exit 1; done",
    "test:pep": "tsx --env-file=.env.local worker/a2a.test.mts",
    "test:a2a": "tsx --env-file=.env.local worker/a2a.test.mts && tsx --env-file=.env.local worker/delegation.test.mts",
    "test:red-team": "tsx --env-file=.env.local worker/red-team.test.mts",
    "test:mcp": "tsx --env-file=.env.local worker/mcp.test.mts && tsx --env-file=.env.local worker/mcp-http.test.mts && tsx --env-file=.env.local worker/mcp-repo.test.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.52",
    "@ai-sdk/openai-compatible": "^1.0.52",
    "@ai-sdk/react": "^2.0.252",
    "@assistant-ui/ai-sdk": "^0.0.3",
    "@assistant-ui/react": "^0.15.17",
    "@assistant-ui/react-ai-sdk": "^1.4.8",
    "@assistant-ui/react-markdown": "^0.14.13",
    "@assistant-ui/react-o11y": "^0.0.42",
    "@auth/drizzle-adapter": "^1.11.3",
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.21",
    "@huggingface/transformers": "^4.2.0",
    "@langfuse/otel": "^5.11.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.221.0",
    "ai": "^5.0.249",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.46.0",
    "imapflow": "^1.7.8",
    "lucide-react": "^1.38.0",
    "mailparser": "^3.9.20",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.12",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.10",
