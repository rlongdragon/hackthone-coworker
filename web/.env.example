# --- LLM gateway (any OpenAI-format endpoint) ---
LLM_BASE_URL=https://your-gateway.example.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=your-model-name

# --- Langfuse(pk/sk 見 docker-compose.langfuse.yml 的 LANGFUSE_INIT_PROJECT_* 值)---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASEURL=http://localhost:3001

# --- DB + Auth (defaults match docker-compose.postgres.yml) ---
DATABASE_URL=postgres://coworker:coworker@localhost:5433/coworker
# generate with: openssl rand -base64 32
AUTH_SECRET=change-me
AUTH_TRUST_HOST=true

# --- Telegram channel (optional; worker: npm run worker:telegram) ---
# BotFather /newbot → token. Leave unset to disable the channel.
TELEGRAM_BOT_TOKEN=
# Bot username (without @) — shown on /me for the link flow.
TELEGRAM_BOT_USERNAME=
# Max concurrent agent turns in the worker (default 4).
TELEGRAM_MAX_TURNS=4
# Public URL of the web app — used in bot onboarding messages (link-code page).
APP_BASE_URL=http://localhost:8090
# Daily briefing time (Asia/Taipei). Group mode: admin runs /authorize in the
# group; for name-prefix triggers + rolling context, disable BotFather group
# privacy (/mybots → Bot Settings → Group Privacy → Turn off).
TELEGRAM_BRIEFING_HOUR=8
TELEGRAM_BRIEFING_MINUTE=30
